    "events": {
      "historyjam:start_retreat": {
        "remove": {
          "component_groups": [
            "historyjam:fresh_retreat_monitor"
          ]
        },
        "add": {
          "component_groups": [
            "historyjam:retreating"
          ]
        }
      },
      "historyjam:begin_regroup": {
        "remove": {
          "component_groups": [
            "historyjam:retreating"
          ]
        },
        "add": {
          "component_groups": [
