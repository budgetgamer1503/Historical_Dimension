{
  "namespace": "historyjam_boss_hud",
  "prefixed_label": {
    "$prefix|default": "HJBOSS_INTRO_",
    "$label_size|default": ["88%", 76],
    "$label_offset|default": [0, -2],
    "$font_scale|default": 1.0,
    "type": "label",
    "size": "$label_size",
    "offset": "$label_offset",
    "anchor_from": "center",
    "anchor_to": "center",
    "text": "#historyjam_boss_text",
    "text_alignment": "center",
    "font_type": "MinecraftTen",
    "font_scale_factor": "$font_scale",
    "color": "white",
    "shadow": true,
    "layer": 82,
    "bindings": [
      {
        "binding_name": "#hud_title_text_string",
        "binding_type": "global"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#hud_title_text_string - $prefix) = #hud_title_text_string))",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view",
        "source_property_name": "('§r' + (#hud_title_text_string - $prefix))",
        "target_property_name": "#historyjam_boss_text"
      }
    ]
  },
  "overlay": {
    "type": "panel",
    "size": ["100%", "100%"],
    "layer": 80,
    "controls": [
      {
        "top_letterbox": {
          "type": "image",
          "texture": "textures/ui/Black",
          "size": ["100%", 34],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "alpha": 0.92,
          "layer": 80
        }
      },
      {
        "bottom_letterbox": {
          "type": "image",
          "texture": "textures/ui/Black",
          "size": ["100%", 34],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "alpha": 0.92,
          "layer": 80
        }
      },
      {
        "center_scrim": {
          "type": "image",
          "texture": "textures/ui/Black",
          "size": ["92%", 88],
          "anchor_from": "center",
          "anchor_to": "center",
          "alpha": 0.28,
          "layer": 80
        }
      },
      {
        "intro_text@historyjam_boss_hud.prefixed_label": {
          "$prefix": "HJBOSS_INTRO_",
          "$label_size": ["88%", 82],
          "$label_offset": [0, -3],
          "$font_scale": 1.05
        }
      },
      {
        "phase_text@historyjam_boss_hud.prefixed_label": {
          "$prefix": "HJBOSS_PHASE_",
          "$label_size": ["82%", 68],
          "$label_offset": [0, 0],
          "$font_scale": 0.9
        }
      },
      {
        "victory_text@historyjam_boss_hud.prefixed_label": {
          "$prefix": "HJBOSS_VICTORY_",
          "$label_size": ["88%", 82],
          "$label_offset": [0, -3],
          "$font_scale": 1.05
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#hud_title_text_string",
        "binding_type": "global"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#hud_title_text_string - 'HJBOSS_') = #hud_title_text_string))",
        "target_property_name": "#visible"
      }
    ]
  }
}
