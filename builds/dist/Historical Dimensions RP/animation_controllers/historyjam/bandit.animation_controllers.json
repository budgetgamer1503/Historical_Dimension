{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.historyjam.bandit.locomotion": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"animations": [
						"idle"
					],
					"blend_transition": 0.15,
					"transitions": [
						{
							"run": "query.ground_speed>=2"
						},
						{
							"walk": "query.ground_speed>0.05"
						}
					]
				},
				"walk": {
					"animations": [
						"walk"
					],
					"blend_transition": 0.15,
					"transitions": [
						{
							"run": "query.ground_speed>=2"
						},
						{
							"idle": "query.ground_speed<=0.05"
						}
					]
				},
				"run": {
					"animations": [
						"run"
					],
					"blend_transition": 0.15,
					"transitions": [
						{
							"walk": "query.ground_speed<2&&query.ground_speed>0.05"
						},
						{
							"idle": "query.ground_speed<=0.05"
						}
					]
				}
			}
		}
	}
}