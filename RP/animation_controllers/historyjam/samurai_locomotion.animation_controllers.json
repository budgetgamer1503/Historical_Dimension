{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.historyjam.samurai.locomotion": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [
            {"run": "query.modified_move_speed > 0.22"},
            {"walk": "query.modified_move_speed > 0.02"}
          ],
          "blend_transition": 0.12
        },
        "walk": {
          "animations": ["walk"],
          "transitions": [
            {"run": "query.modified_move_speed > 0.22"},
            {"idle": "query.modified_move_speed <= 0.02"}
          ],
          "blend_transition": 0.1
        },
        "run": {
          "animations": ["run"],
          "transitions": [
            {"walk": "query.modified_move_speed <= 0.22 && query.modified_move_speed > 0.02"},
            {"idle": "query.modified_move_speed <= 0.02"}
          ],
          "blend_transition": 0.08
        }
      }
    }
  }
}
